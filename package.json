{
  "name": "pj-worker-quality",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "prettier": {
    "printWidth": 100
  },
  "scripts": {
    "format:check": "prettier --check pj_realtime_backend_worker.js web/*.js tests/*.mjs",
    "lint": "eslint pj_realtime_backend_worker.js web/*.js tests/*.mjs",
    "test": "node --test tests/test_worker_auth.mjs tests/test_browser_client.mjs && npm run test:deployment",
    "test:deployment": "bash tests/test_verify_cloudflare_sync.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6"
  }
}
