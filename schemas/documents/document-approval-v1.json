{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pj.local/schemas/documents/document-approval-v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\\\d*)\\\\.(0|[1-9]\\\\d*)\\\\.(0|[1-9]\\\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\\\+[0-9A-Za-z.-]+)?$"
    },
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){1,15}$"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){1,15}$"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected",
        "changes_requested",
        "revoked"
      ]
    },
    "approver": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
    },
    "decided_at": {
      "type": "string",
      "pattern": "^\\\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\\\d|3[01])T(?:[01]\\\\d|2[0-3]):[0-5]\\\\d:[0-5]\\\\d(?:\\\\.\\\\d+)?Z$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "supersedes_approval_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){1,15}$"
    }
  },
  "required": [
    "schema_version",
    "stable_id",
    "approval_id",
    "decision",
    "approver",
    "decided_at",
    "content_sha256",
    "supersedes_approval_id"
  ]
}
