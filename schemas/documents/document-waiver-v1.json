{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pj.local/schemas/documents/document-waiver-v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\\\d*)\\\\.(0|[1-9]\\\\d*)\\\\.(0|[1-9]\\\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\\\+[0-9A-Za-z.-]+)?$"
    },
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){1,15}$"
    },
    "waiver_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){1,15}$"
    },
    "control_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "reason": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "approved_by": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
    },
    "approved_at": {
      "type": "string",
      "pattern": "^\\\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\\\d|3[01])T(?:[01]\\\\d|2[0-3]):[0-5]\\\\d:[0-5]\\\\d(?:\\\\.\\\\d+)?Z$"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\\\d|3[01])T(?:[01]\\\\d|2[0-3]):[0-5]\\\\d:[0-5]\\\\d(?:\\\\.\\\\d+)?Z$"
    },
    "status": {
      "enum": [
        "active",
        "expired",
        "revoked"
      ]
    },
    "supersedes_waiver_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){1,15}$"
    }
  },
  "required": [
    "schema_version",
    "stable_id",
    "waiver_id",
    "control_id",
    "reason",
    "approved_by",
    "approved_at",
    "expires_at",
    "status",
    "supersedes_waiver_id"
  ]
}
