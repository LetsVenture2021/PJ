{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pj.local/schemas/workflow-v1.schema.json",
  "title": "PJ declarative workflow",
  "type": "object",
  "required": ["name", "version", "author", "input_schema", "output_schema", "steps"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "author": {"type": "string", "minLength": 1},
    "assistant_profile": {"type": "object"},
    "input_schema": {"type": "object"},
    "output_schema": {"type": "object"},
    "tools": {"type": "object"},
    "knowledge": {"type": "array", "items": {"type": "object"}},
    "policy": {"type": "object"},
    "budget": {"type": "object"},
    "compatibility_version": {"const": "1.0"},
    "realtime_compatible": {"type": "boolean"},
    "steps": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["prompt", "local_tool", "connector_read", "connector_action", "approval", "branch", "parallel_read", "validation", "artifact_output"]},
        "next": {"type": "array", "items": {"type": "string"}},
        "config": {"type": "object"},
        "effect": {"enum": ["none", "local", "external_read", "external_write"]},
        "rollback": {"const": "provider_supported"}
      }, "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
