{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pj.local/contracts/extensions/event-source-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_schema",
    "delivery"
  ],
  "properties": {
    "event_schema": {
      "type": "object"
    },
    "delivery": {
      "enum": [
        "poll",
        "push",
        "local"
      ]
    }
  }
}
