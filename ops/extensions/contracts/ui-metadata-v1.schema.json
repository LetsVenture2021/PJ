{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pj.local/contracts/extensions/ui-metadata-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "display_name",
    "description"
  ],
  "properties": {
    "display_name": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "icon": {
      "type": "string"
    }
  }
}
