{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pj.local/contracts/extensions/workflow-template-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "steps"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
