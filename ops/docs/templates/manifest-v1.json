{
  "manifest_id": "pj.docops.templates",
  "manifest_version": 1,
  "status": "approved",
  "approved_by": "repository-owner",
  "approved_at": "2026-07-29",
  "requirement_levels": {
    "required": "must be present",
    "conditional": "required when its rule applies",
    "optional": "may be omitted"
  },
  "templates": [
    {
      "id": "architecture_reference",
      "version": 1,
      "description": "Architecture decision/reference",
      "purpose": "Document system context and durable design decisions",
      "sections": [
        {
          "name": "Purpose",
          "requirement": "required",
          "rationale": "Defines the decision or reference boundary."
        },
        {
          "name": "Context",
          "requirement": "required",
          "rationale": "Records forces and constraints needed to interpret the design."
        },
        {
          "name": "Architecture",
          "requirement": "required",
          "rationale": "Describes components, interfaces, and data flow."
        },
        {
          "name": "Decisions",
          "requirement": "required",
          "rationale": "Makes accepted choices and rationale auditable."
        },
        {
          "name": "Consequences",
          "requirement": "required",
          "rationale": "Records benefits, costs, and trade-offs."
        },
        {
          "name": "Alternatives",
          "requirement": "optional",
          "rationale": "Preserves meaningful rejected options."
        },
        {
          "name": "Authoritative References",
          "requirement": "conditional",
          "rationale": "Anchors claims when external contracts or standards govern the design."
        }
      ],
      "conditional_rules": []
    },
    {
      "id": "incident_runbook",
      "version": 1,
      "description": "Incident runbook",
      "purpose": "Guide safe diagnosis, mitigation, recovery, and escalation",
      "sections": [
        {
          "name": "Scope",
          "requirement": "required",
          "rationale": "Defines affected services and incident boundary."
        },
        {
          "name": "Severity and Ownership",
          "requirement": "required",
          "rationale": "Establishes escalation and accountable roles."
        },
        {
          "name": "Detection",
          "requirement": "required",
          "rationale": "Provides observable entry criteria."
        },
        {
          "name": "Diagnosis",
          "requirement": "required",
          "rationale": "Makes investigation repeatable."
        },
        {
          "name": "Mitigation",
          "requirement": "required",
          "rationale": "Provides safe containment actions."
        },
        {
          "name": "Rollback",
          "requirement": "conditional",
          "rationale": "Restores the last known-good state after an operational change."
        },
        {
          "name": "Verification",
          "requirement": "required",
          "rationale": "Proves service and security recovery."
        },
        {
          "name": "Communication",
          "requirement": "required",
          "rationale": "Coordinates stakeholders and records updates."
        },
        {
          "name": "References",
          "requirement": "optional",
          "rationale": "Links dashboards and supporting procedures."
        }
      ],
      "conditional_rules": [
        {
          "id": "operational-change-safety",
          "when": "the procedure changes runtime state, configuration, data, or deployment",
          "require": [
            "Rollback",
            "Verification"
          ],
          "rationale": "Operational changes need a recovery path and an independently observable success check."
        }
      ]
    },
    {
      "id": "security_control_specification",
      "version": 1,
      "description": "Security-control specification",
      "purpose": "Specify a testable security control and its assurance evidence",
      "sections": [
        {
          "name": "Control Objective",
          "requirement": "required",
          "rationale": "States the risk reduction goal."
        },
        {
          "name": "Scope and Threats",
          "requirement": "required",
          "rationale": "Defines assets, actors, and threats."
        },
        {
          "name": "Control Requirements",
          "requirement": "required",
          "rationale": "Makes normative behavior testable."
        },
        {
          "name": "Implementation",
          "requirement": "required",
          "rationale": "Maps requirements to enforcement points."
        },
        {
          "name": "Verification and Evidence",
          "requirement": "required",
          "rationale": "Defines tests and retained assurance evidence."
        },
        {
          "name": "Exceptions",
          "requirement": "conditional",
          "rationale": "Governs deviations and compensating controls."
        },
        {
          "name": "Authoritative References",
          "requirement": "required",
          "rationale": "Binds requirements to applicable standards and primary sources."
        },
        {
          "name": "Ownership and Review",
          "requirement": "required",
          "rationale": "Assigns operation and periodic review."
        }
      ],
      "conditional_rules": [
        {
          "id": "authoritative-security-basis",
          "when": "always",
          "require": [
            "Authoritative References"
          ],
          "rationale": "Security requirements must be traceable to primary policy, standards, or vendor documentation."
        }
      ]
    },
    {
      "id": "dependency_audit",
      "version": 1,
      "description": "Dependency audit",
      "purpose": "Assess dependency currency, exposure, and remediation",
      "sections": [
        {
          "name": "Scope and Snapshot",
          "requirement": "required",
          "rationale": "Pins manifests, lockfiles, and audit time."
        },
        {
          "name": "Method",
          "requirement": "required",
          "rationale": "Makes collection and severity rules reproducible."
        },
        {
          "name": "Findings",
          "requirement": "required",
          "rationale": "Records affected packages and evidence."
        },
        {
          "name": "Risk Assessment",
          "requirement": "required",
          "rationale": "Prioritizes reachability and business impact."
        },
        {
          "name": "Remediation",
          "requirement": "required",
          "rationale": "Assigns safe upgrades or acceptance."
        },
        {
          "name": "Verification",
          "requirement": "required",
          "rationale": "Defines checks after dependency changes."
        },
        {
          "name": "Limitations",
          "requirement": "required",
          "rationale": "Discloses unavailable feeds and analysis gaps."
        },
        {
          "name": "References",
          "requirement": "optional",
          "rationale": "Links advisories and primary records."
        }
      ],
      "conditional_rules": []
    },
    {
      "id": "code_review",
      "version": 1,
      "description": "Code review",
      "purpose": "Record correctness, security, and maintainability review",
      "sections": [
        {
          "name": "Scope",
          "requirement": "required",
          "rationale": "Pins reviewed revisions and excluded areas."
        },
        {
          "name": "Method",
          "requirement": "required",
          "rationale": "States checks and review approach."
        },
        {
          "name": "Findings",
          "requirement": "required",
          "rationale": "Provides severity, location, impact, and remediation."
        },
        {
          "name": "Validation",
          "requirement": "required",
          "rationale": "Records tests and static checks."
        },
        {
          "name": "Limitations",
          "requirement": "required",
          "rationale": "Prevents overclaiming beyond inspected evidence."
        },
        {
          "name": "Disposition",
          "requirement": "required",
          "rationale": "States approval or blocking work."
        }
      ],
      "conditional_rules": []
    },
    {
      "id": "customer_evaluation",
      "version": 1,
      "description": "Customer evaluation",
      "purpose": "Evaluate customer experience using explicit evidence and criteria",
      "sections": [
        {
          "name": "Objective and Audience",
          "requirement": "required",
          "rationale": "Defines the decision and represented users."
        },
        {
          "name": "Method and Evidence",
          "requirement": "required",
          "rationale": "Makes observations traceable."
        },
        {
          "name": "Findings",
          "requirement": "required",
          "rationale": "Separates observations from interpretation."
        },
        {
          "name": "Limitations",
          "requirement": "required",
          "rationale": "Discloses sample, environment, and access constraints."
        },
        {
          "name": "Recommendations",
          "requirement": "required",
          "rationale": "Connects evidence to prioritized action."
        },
        {
          "name": "Success Measures",
          "requirement": "conditional",
          "rationale": "Defines validation when changes are proposed."
        }
      ],
      "conditional_rules": [
        {
          "id": "evaluation-limitations",
          "when": "always",
          "require": [
            "Limitations"
          ],
          "rationale": "Evaluations must disclose sampling, access, and inference boundaries."
        }
      ]
    },
    {
      "id": "product_technology_report",
      "version": 1,
      "description": "Product/technology report",
      "purpose": "Synthesize product and technical state for decisions",
      "sections": [
        {
          "name": "Executive Summary",
          "requirement": "required",
          "rationale": "Surfaces the decision-relevant conclusion."
        },
        {
          "name": "Scope and Method",
          "requirement": "required",
          "rationale": "Defines sources and analysis boundary."
        },
        {
          "name": "Product Assessment",
          "requirement": "required",
          "rationale": "Assesses user and market outcomes."
        },
        {
          "name": "Technology Assessment",
          "requirement": "required",
          "rationale": "Assesses architecture, delivery, and operations."
        },
        {
          "name": "Risks and Opportunities",
          "requirement": "required",
          "rationale": "Frames material implications."
        },
        {
          "name": "Recommendations",
          "requirement": "required",
          "rationale": "Turns analysis into owned action."
        },
        {
          "name": "Limitations",
          "requirement": "required",
          "rationale": "Discloses evidence and access gaps."
        },
        {
          "name": "References",
          "requirement": "optional",
          "rationale": "Links supporting sources."
        }
      ],
      "conditional_rules": [
        {
          "id": "research-limitations",
          "when": "always",
          "require": [
            "Limitations"
          ],
          "rationale": "Research synthesis must distinguish evidence from inference and disclose gaps."
        }
      ]
    },
    {
      "id": "product_vision",
      "version": 1,
      "description": "Product vision",
      "purpose": "Align outcomes, principles, experience, and measures",
      "sections": [
        {
          "name": "Vision",
          "requirement": "required",
          "rationale": "States the durable future state."
        },
        {
          "name": "Users and Needs",
          "requirement": "required",
          "rationale": "Anchors vision in beneficiaries and problems."
        },
        {
          "name": "Product Promise",
          "requirement": "required",
          "rationale": "Defines differentiated value."
        },
        {
          "name": "Principles",
          "requirement": "required",
          "rationale": "Guides decisions under ambiguity."
        },
        {
          "name": "Experience",
          "requirement": "required",
          "rationale": "Makes the intended journey tangible."
        },
        {
          "name": "Measures",
          "requirement": "required",
          "rationale": "Defines outcome-based success."
        },
        {
          "name": "Non-goals",
          "requirement": "optional",
          "rationale": "Protects focus and clarifies boundaries."
        },
        {
          "name": "Roadmap Implications",
          "requirement": "conditional",
          "rationale": "Connects the vision to sequencing when planning is in scope."
        }
      ],
      "conditional_rules": []
    },
    {
      "id": "protocol_specification",
      "version": 1,
      "description": "Protocol specification",
      "purpose": "Define interoperable wire behavior and compatibility",
      "sections": [
        {
          "name": "Scope and Terminology",
          "requirement": "required",
          "rationale": "Defines protocol boundary and normative terms."
        },
        {
          "name": "Versioning and Compatibility",
          "requirement": "required",
          "rationale": "Controls evolution and negotiation."
        },
        {
          "name": "Message Formats",
          "requirement": "required",
          "rationale": "Defines schemas and invariants."
        },
        {
          "name": "State and Flows",
          "requirement": "required",
          "rationale": "Defines ordering and lifecycle behavior."
        },
        {
          "name": "Errors and Recovery",
          "requirement": "required",
          "rationale": "Makes failure behavior interoperable."
        },
        {
          "name": "Security Considerations",
          "requirement": "required",
          "rationale": "Addresses authentication, validation, and abuse."
        },
        {
          "name": "Conformance",
          "requirement": "required",
          "rationale": "Defines testable implementation obligations."
        },
        {
          "name": "Authoritative References",
          "requirement": "required",
          "rationale": "Anchors external protocols and standards in primary sources."
        }
      ],
      "conditional_rules": [
        {
          "id": "authoritative-protocol-basis",
          "when": "always",
          "require": [
            "Authoritative References"
          ],
          "rationale": "Protocol claims must map to governing standards or primary API contracts."
        }
      ]
    },
    {
      "id": "integration_guide",
      "version": 1,
      "description": "Integration guide",
      "purpose": "Enable a safe, verifiable external-system integration",
      "sections": [
        {
          "name": "Overview",
          "requirement": "required",
          "rationale": "Defines outcome and integration boundary."
        },
        {
          "name": "Prerequisites",
          "requirement": "required",
          "rationale": "Lists access, versions, and dependencies."
        },
        {
          "name": "Configuration",
          "requirement": "required",
          "rationale": "Provides reproducible setup."
        },
        {
          "name": "Data and API Contract",
          "requirement": "required",
          "rationale": "Defines exchanged data and interfaces."
        },
        {
          "name": "Security",
          "requirement": "required",
          "rationale": "Covers credentials, least privilege, and validation."
        },
        {
          "name": "Verification",
          "requirement": "required",
          "rationale": "Proves expected behavior."
        },
        {
          "name": "Rollback",
          "requirement": "conditional",
          "rationale": "Provides reversal for stateful or operational changes."
        },
        {
          "name": "Troubleshooting",
          "requirement": "required",
          "rationale": "Maps symptoms to safe diagnostics."
        },
        {
          "name": "References",
          "requirement": "optional",
          "rationale": "Links primary provider documentation."
        }
      ],
      "conditional_rules": [
        {
          "id": "integration-change-safety",
          "when": "integration steps modify production state or configuration",
          "require": [
            "Rollback",
            "Verification"
          ],
          "rationale": "Stateful integration work requires reversal and observable verification."
        }
      ]
    },
    {
      "id": "training_corpus",
      "version": 1,
      "description": "Training corpus",
      "purpose": "Govern an untrusted, structured knowledge corpus",
      "sections": [
        {
          "name": "Untrusted Data Banner",
          "requirement": "required",
          "rationale": "Prevents corpus instructions from being treated as trusted commands."
        },
        {
          "name": "Corpus Metadata",
          "requirement": "required",
          "rationale": "Pins schema, version, and record totals."
        },
        {
          "name": "Source Mapping",
          "requirement": "required",
          "rationale": "Maps every record to a source census identity and digest."
        },
        {
          "name": "Records",
          "requirement": "required",
          "rationale": "Stores repeated, machine-validated items."
        },
        {
          "name": "Limitations",
          "requirement": "required",
          "rationale": "Discloses coverage and freshness boundaries."
        },
        {
          "name": "Validation",
          "requirement": "required",
          "rationale": "Records parser and structural checks."
        },
        {
          "name": "Regeneration",
          "requirement": "conditional",
          "rationale": "Defines an operator workflow only after evaluator help and inputs are reviewed."
        }
      ],
      "conditional_rules": [
        {
          "id": "untrusted-corpus",
          "when": "always",
          "require": [
            "Untrusted Data Banner",
            "Validation"
          ],
          "rationale": "Corpus content is data, not instruction, and repeated structure must be validated."
        }
      ]
    },
    {
      "id": "evidence_receipt_source_census",
      "version": 1,
      "description": "Evidence receipt and source census",
      "purpose": "Bind sources, evaluation evidence, controls, and exact inputs",
      "sections": [
        {
          "name": "Evidence Set Identity",
          "requirement": "required",
          "rationale": "Assigns stable version and evaluation identity."
        },
        {
          "name": "Source Census",
          "requirement": "required",
          "rationale": "Inventories every source and disposition."
        },
        {
          "name": "Corpus Locations",
          "requirement": "required",
          "rationale": "Maps each evaluated control to record and location."
        },
        {
          "name": "Evaluation Evidence",
          "requirement": "required",
          "rationale": "Records method, cases, results, and limitations."
        },
        {
          "name": "Input Hashes",
          "requirement": "required",
          "rationale": "Cryptographically binds exact corpus, census, evidence, and evaluator inputs."
        },
        {
          "name": "Approval and Supersession",
          "requirement": "required",
          "rationale": "Records accountable release and lineage."
        },
        {
          "name": "Exceptions",
          "requirement": "optional",
          "rationale": "Documents unresolved mapping or access gaps."
        }
      ],
      "conditional_rules": [
        {
          "id": "complete-traceability",
          "when": "always",
          "require": [
            "Source Census",
            "Corpus Locations",
            "Evaluation Evidence",
            "Input Hashes"
          ],
          "rationale": "Every source, control, and released result must be traceable to exact inputs."
        }
      ]
    }
  ]
}
